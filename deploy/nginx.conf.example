# VendSlip — single-domain production layout (e.g. https://vendslip.com)
#
#   /                   -> React SPA (Frontend/dist), with history fallback for /verify/*, /pay/*, /dashboard/*
#   /api, /sanctum      -> Laravel (php-fpm)   — same origin, so Sanctum session cookies just work
#   /admin, /build, /up -> Laravel              — Blade Admin & Super-Admin portal, its assets, health check
#   /storage            -> Laravel public disk  — merchant logos (php artisan storage:link)
#
# Replace /var/www/vendslip and the php-fpm socket with your own paths.

server {
    listen 80;
    server_name vendslip.com www.vendslip.com;
    return 301 https://vendslip.com$request_uri;
}

server {
    listen 443 ssl http2;   # nginx >= 1.25.1 may use `listen 443 ssl;` + `http2 on;` instead
    server_name vendslip.com;

    ssl_certificate     /etc/letsencrypt/live/vendslip.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vendslip.com/privkey.pem;

    client_max_body_size 4m;   # logo uploads are capped at 1 MB by validation
    server_tokens off;

    set $laravel /var/www/vendslip/Backend/public;
    root /var/www/vendslip/Frontend/dist;
    index index.html;

    # ---- Laravel ---------------------------------------------------------
    location ~ ^/(api|sanctum|admin|up)(/|$) {
        root $laravel;
        try_files $uri /index.php?$query_string;
    }

    location ^~ /build/   { root $laravel; access_log off; expires 1y; add_header Cache-Control "public, immutable"; }
    location ^~ /storage/ { root $laravel; try_files $uri =404; access_log off; expires 7d; }

    location = /index.php {
        root $laravel;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $laravel/index.php;
        include fastcgi_params;
        fastcgi_param HTTPS on;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 60s;
    }

    # Never execute or expose any other PHP or dotfiles
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known) { deny all; }

    # ---- React SPA -------------------------------------------------------
    location ^~ /assets/ { access_log off; expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }

    location / {
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Cache-Control "no-cache" always;   # index.html must never be cached; hashed assets are
        try_files $uri $uri/ /index.html;
    }
}
