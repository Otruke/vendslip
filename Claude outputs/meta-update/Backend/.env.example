APP_NAME=VendSlip
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vendslip_db
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# VendSlip
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
# Comma-separated proxy IPs you run (load balancer, ngrok). Leave empty locally.
TRUSTED_PROXIES=
VENDSLIP_TIMEZONE=Africa/Lagos
# HMAC key for QR verification. Empty = derived from APP_KEY. Never change it after go-live.
VENDSLIP_VERIFICATION_KEY=
VENDSLIP_PDF_DISK=local
VENDSLIP_PDF_LINK_MINUTES=10080
VENDSLIP_DRAFT_TTL_MINUTES=1440
VENDSLIP_SUPER_ADMIN_EMAIL=superadmin@vendslip.test
# Set before seeding; if empty a random password is printed once by the seeder.
VENDSLIP_SUPER_ADMIN_PASSWORD=

# Telegram (Bot API 10.3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_RICH_MESSAGES=true
TELEGRAM_API_BASE=https://api.telegram.org

# Twilio (WhatsApp, Instagram DM, Facebook Messenger)
# WhatsApp / Messenger / Instagram route: meta (primary) or twilio (secondary).
VENDSLIP_META_CHANNELS_PROVIDER=meta

# Meta Cloud API + Messenger Platform (primary). All editable at /admin/gateways.
META_GRAPH_VERSION=v24.0
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_WHATSAPP_NUMBER=
META_PAGE_ID=
META_PAGE_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_INSTAGRAM_USERNAME=
META_INSTAGRAM_TOKEN=
META_INSTAGRAM_APP_SECRET=
META_VALIDATE_SIGNATURE=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_INSTAGRAM_FROM=
TWILIO_FACEBOOK_FROM=
TWILIO_WHATSAPP_CONFIRM_CONTENT_SID=
TWILIO_VALIDATE_SIGNATURE=true

# Platform billing gateways (can also be set by Super-Admin in /admin/gateways)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PRICE_CURRENCY=ngn
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
