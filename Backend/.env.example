# =============================================================================
# VendSlip backend settings
# Copy this file to .env and fill it in. After changing .env, run:
#   php artisan optimize:clear
# Values marked "Admin" can also be set (and override .env) in Super-Admin → Gateways & Bots.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_NAME=VendSlip
# local while developing; production on the live server (hides error details, enables caching).
APP_ENV=local
# Encryption key. Generate once with: php artisan key:generate. Never change it after go-live.
APP_KEY=
# true shows full error pages. Must be false in production.
APP_DEBUG=true
# The API's public address. Webhooks (payments, Meta, Telegram, Twilio) and signed file links use it.
# Locally with a tunnel: https://your-tunnel-domain. Live: https://vendslip.com (or api.vendslip.com).
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Password hashing strength. 12 is a good default.
BCRYPT_ROUNDS=12

# Logs go to storage/logs/laravel.log. Use LOG_LEVEL=warning in production.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vendslip_db
DB_USERNAME=postgres
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions, cache and queue
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
# Minutes of inactivity before a sign-in expires.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Live (HTTPS) only: send the sign-in cookie over HTTPS only.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Alerts and emails are queued; the scheduler (php artisan schedule:work / cron) sends them every minute.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# log = emails are written to storage/logs/laravel.log instead of being sent (good for testing).
# For real sending use smtp (with MAIL_HOST/PORT/USERNAME/PASSWORD) or another mailer.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# The "From" on every email (alerts, receipts, reminders, password resets).
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only for Amazon S3 storage (needs an extra package). Not used by VendSlip by default.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Name used by the admin portal's build. Leave as is.
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# VendSlip
# =============================================================================

# -----------------------------------------------------------------------------
# Addresses and sign-in
# -----------------------------------------------------------------------------
# The web app's public address (public site, dashboard, customer pages). Every link a customer sees
# uses it: the short slip link (/s/…), verification and payment pages, and email links.
# Must be a public address (not localhost) or customers can't open the links.
FRONTEND_URL=http://localhost:5173
# Optional shorter domain for the links sent to customers, e.g. https://vsl.ng → https://vsl.ng/s/Ab3dE9xQ2.
# It must serve the same web app. Empty = FRONTEND_URL.
VENDSLIP_SHARE_URL=
# Addresses (host:port, no https://) allowed to sign in to the dashboard with cookies.
# Add your tunnel or live domain, e.g. vendslip.com,www.vendslip.com
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000
# Comma-separated IPs of proxies in front of the app (load balancer, tunnel), or * to trust any.
# Needed so HTTPS and Twilio signatures are detected correctly behind a proxy or tunnel.
# Use * only when every request really comes through your own proxy. Leave empty for plain localhost.
TRUSTED_PROXIES=
# Time zone for dates on slips, due dates, reminders and daily jobs.
VENDSLIP_TIMEZONE=Africa/Lagos

# -----------------------------------------------------------------------------
# Slips and PDFs
# -----------------------------------------------------------------------------
# Secret key behind every slip's verification code and QR. Empty = derived from APP_KEY.
# Set a long random value before go-live and NEVER change it: changing it breaks every existing QR.
VENDSLIP_VERIFICATION_KEY=
# Where generated PDFs are stored. local = Backend/storage/app (keep this unless you add cloud storage).
VENDSLIP_PDF_DISK=local
# How long a signed PDF address stays valid for chat apps to fetch the attachment (minutes). 10080 = 7 days.
# Customers never see this address; they use the short link.
VENDSLIP_PDF_LINK_MINUTES=10080
# Minutes before an unfinished chat draft expires. 1440 = 24 hours (matches WhatsApp's reply window).
VENDSLIP_DRAFT_TTL_MINUTES=1440

# -----------------------------------------------------------------------------
# Super-Admin and support access
# -----------------------------------------------------------------------------
# The first Super-Admin account, created when the database is seeded.
VENDSLIP_SUPER_ADMIN_EMAIL=superadmin@vendslip.test
# Set before seeding; if empty, a random password is printed once by the seeder.
VENDSLIP_SUPER_ADMIN_PASSWORD=
# Support access to a business's dashboard: how long the owner's one-time code is valid (minutes).
VENDSLIP_SUPPORT_CODE_MINUTES=10
# How long a support session lasts before it ends automatically (minutes).
VENDSLIP_SUPPORT_SESSION_MINUTES=60

# -----------------------------------------------------------------------------
# Terms of Service and Privacy Policy (shown at /terms and /privacy)
# -----------------------------------------------------------------------------
# The first version's date (YYYY-MM-DD). Later versions are published from Super-Admin → Terms & Privacy.
VENDSLIP_LEGAL_VERSION=2026-11-08
# Company name and address shown in both documents.
VENDSLIP_LEGAL_ENTITY="Techberryz Futurecore Limited"
VENDSLIP_LEGAL_ADDRESS="Lagos, Nigeria"
# Real mailboxes people can write to: privacy requests and general support.
VENDSLIP_PRIVACY_EMAIL=privacy@vendslip.com
VENDSLIP_SUPPORT_EMAIL=support@vendslip.com
# true = once a newer version applies, users must accept it before they can change anything.
VENDSLIP_LEGAL_REQUIRE_CURRENT=true

# -----------------------------------------------------------------------------
# Exchange rates (prices of plans in other currencies). Free service, no key.
# -----------------------------------------------------------------------------
VENDSLIP_FX_URL=https://open.er-api.com/v6/latest/USD

# -----------------------------------------------------------------------------
# Telegram bot (Admin). Setup: info/TESTING.md, section 2
# -----------------------------------------------------------------------------
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# The bot's username without @ (used for t.me links in the dashboard).
TELEGRAM_BOT_USERNAME=
# Any long random string. Telegram sends it with every update so fake requests are refused.
# Re-register the webhook after changing it: php artisan vendslip:telegram-webhook
TELEGRAM_WEBHOOK_SECRET=
# true = tables and embedded PDFs in Telegram (Bot API 10.3); false = plain messages.
TELEGRAM_RICH_MESSAGES=true
TELEGRAM_API_BASE=https://api.telegram.org

# -----------------------------------------------------------------------------
# Chat route for WhatsApp, Messenger and Instagram (Admin)
# -----------------------------------------------------------------------------
# meta = Meta Cloud API (primary) · twilio = Twilio (secondary). Only the chosen route replies.
VENDSLIP_META_CHANNELS_PROVIDER=meta

# -----------------------------------------------------------------------------
# Meta: WhatsApp, Messenger, Instagram (Admin). Setup: info/META-SETUP.md
# Webhook for all three: https://YOUR-DOMAIN/api/v1/webhooks/meta
# -----------------------------------------------------------------------------
# Graph API version. v24.0 is supported until Feb 2028.
META_GRAPH_VERSION=v24.0
# App settings → Basic → App secret. Checks every webhook really comes from Meta.
META_APP_SECRET=
# Any long random string; type the same value in Meta's webhook settings.
META_VERIFY_TOKEN=
# WhatsApp → API Setup → Phone number ID (the long ID, not the phone number).
META_WHATSAPP_PHONE_NUMBER_ID=
# Test token (24 h) or a System User token that never expires.
META_WHATSAPP_TOKEN=
# The number merchants message, shown in the dashboard, e.g. +2348012345678.
META_WHATSAPP_NUMBER=
# Messenger: the Facebook Page's ID and its access token.
META_PAGE_ID=
META_PAGE_TOKEN=
# Instagram professional account ID (starts 1784…) and username without @.
META_INSTAGRAM_ACCOUNT_ID=
META_INSTAGRAM_USERNAME=
# Only for "Instagram Login" setups. Leave empty when Instagram is linked through the Facebook Page.
META_INSTAGRAM_TOKEN=
META_INSTAGRAM_APP_SECRET=
# Keep true. false skips the webhook signature check (local experiments only).
META_VALIDATE_SIGNATURE=true
# Advanced: Meta API addresses and timeout in seconds. Leave as is.
META_GRAPH_BASE=https://graph.facebook.com
META_INSTAGRAM_BASE=https://graph.instagram.com
META_HTTP_TIMEOUT=15

# -----------------------------------------------------------------------------
# Twilio: WhatsApp and Messenger (Admin). Setup: info/TWILIO-SETUP.md
# Webhooks: …/api/v1/webhooks/whatsapp and …/api/v1/webhooks/facebook
# -----------------------------------------------------------------------------
# Twilio Console → Account Info.
TWILIO_ACCOUNT_SID=
# Also checks every webhook really comes from Twilio. Update here if you rotate it in Twilio.
TWILIO_AUTH_TOKEN=
# Sender with the whatsapp: prefix. Sandbox: whatsapp:+14155238886; live: your approved number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Twilio doesn't offer Instagram: leave empty.
TWILIO_INSTAGRAM_FROM=
# Messenger sender: messenger:<Facebook Page ID>.
TWILIO_FACEBOOK_FROM=
# Optional HX… quick-reply template for Confirm / Edit / Cancel buttons. Empty = "Reply 1, 2 or 3".
TWILIO_WHATSAPP_CONFIRM_CONTENT_SID=
# Keep true. false skips the signature check (local experiments only).
TWILIO_VALIDATE_SIGNATURE=true

# -----------------------------------------------------------------------------
# Payments to VendSlip: plans and credit packs (Admin). Testing: info/TESTING.md, section 1
# Check your keys with: php artisan vendslip:check-gateways
# (Businesses add their own keys for invoice payments in Settings → Payment links.)
# -----------------------------------------------------------------------------
# Flutterwave → Settings → API keys. TEST keys start FLWPUBK_TEST- / FLWSECK_TEST-.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Any long random string; the same value in Flutterwave → Settings → Webhooks.
# Webhook: https://YOUR-DOMAIN/api/v1/webhooks/flutterwave
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
# NOWPayments → Settings → Payments → API keys / Instant payment notifications (IPN secret).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Not used any more: crypto payments are priced in the plan's or invoice's own currency. Safe to leave.
NOWPAYMENTS_PRICE_CURRENCY=ngn
# Live API. The sandbox (https://api-sandbox.nowpayments.io/v1) is no longer maintained by NOWPayments.
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
